PORT=3001
# Proxy trust setting for Express (false, true, numeric hop count, or CIDR/list)
TRUST_PROXY=false
# Secret used to sign short-lived stream tickets (do not expose)
STREAM_TICKET_SECRET=change_me_to_a_long_random_secret

# NodeLink connection
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_NAME=melofy
LAVALINK_PASSWORD=your_lavalink_password
LAVALINK_SECURE=false

# Spotify server credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Firebase Admin SDK — choose ONE method:
# Option A: Path to a service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option B: Base64-encoded service account JSON (for cloud platforms like Railway, Render)
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

# Comma-separated allowed origins for browsers hitting this API
CORS_ORIGINS=http://localhost:3000
