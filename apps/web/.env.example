# Firebase public config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Backend API URL for rewrites and server route proxies
# Backend API URL for rewrites and server route proxies
BACKEND_API_URL=http://localhost:3001

# Firebase Admin SDK — choose ONE method:
# Option A: Path to a service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option B: Base64-encoded service account JSON (for cloud platforms like Railway, Render)
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json
